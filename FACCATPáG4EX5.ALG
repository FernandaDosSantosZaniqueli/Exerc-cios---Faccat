Algoritmo "FaccatPág4Ex5"
// Disciplina   : [Lógica de Programação]
// Professor   : Jailson
// Descrição   : Escreva um algoritmo para ler um valor (do teclado) e escrever (na tela) o seu antecessor
// Autor(a)    : Fernanda
// Data atual  : 16/09/2026
Var
// Seção de Declarações das variáveis 
Numero, Antecessor: inteiro

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
 escreval("======= Antecessor de um número =======")
 escreval("")
 escreval("Digite um número: ")
   leia(Numero)
   escreval("")
   Antecessor <- Numero - 1

   escreval("O antecessor é: ", Antecessor)
Fimalgoritmo