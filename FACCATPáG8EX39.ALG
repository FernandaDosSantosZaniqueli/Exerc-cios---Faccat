Algoritmo "FaccatPág8Ex39"
// Disciplina   : [Lógica de Programação]
// Professor   : Jailson
// Descrição   :Para A = V, B = V e C = F, qual o resultado da avaliação das seguintes expressões:
//a) (A e B) ou (A xou B)
//b) (A ou B) e (A e C)
//c) A ou C e B xou A e não B
// Autor(a)    : Fernanda
// Data atual  : 16/09/2026
Var
// Seção de Declarações das variáveis 
 A, B, C: logico

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc...
escreval("======= Resultado =======")
escreval("")
A <- verdadeiro
   B <- verdadeiro
   C <- falso

   escreval("a) ", (A e B) ou (A xou B))
   escreval("b) ", (A ou B) e (A e C))
   escreval("c) ", A ou C e B xou A e nao B)

Fimalgoritmo